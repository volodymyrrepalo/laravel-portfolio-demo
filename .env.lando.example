# Copy these values into Laravel's .env after the framework is installed.
APP_URL=https://lararepalo.lndo.site:444

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel

# These must be unique secrets. Generate them with: lando artisan reverb:install
# (or replace all three before collaborating with others).
REVERB_APP_ID=lararepalo
REVERB_APP_KEY=lararepalo-local-key
REVERB_APP_SECRET=lararepalo-local-secret

# Internal bind address used by `lando reverb`.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Public address used by Laravel when it publishes broadcasts.
REVERB_HOST=reverb.lararepalo.lndo.site
REVERB_PORT=444
REVERB_SCHEME=https

# Address used by Echo/Vite in the browser.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
